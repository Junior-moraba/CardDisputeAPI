{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run CardDisputeAPI",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/CardDisputeAPI/bin/Debug/net10.0/CardDisputePortal.API.dll",
      "cwd": "${workspaceFolder}/CardDisputeAPI",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:7231"
      },
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
      }
    }
  ]
}
